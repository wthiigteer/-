rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 금쪽같은 내 오가노이드 랭킹: 누구나 읽기, 형식이 맞는 점수만 저장
    match /organoid_rooms/{room}/scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'score', 'first', 'grade', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 120
        && request.resource.data.score % 10 == 0
        && request.resource.data.first is int
        && request.resource.data.first >= 0
        && request.resource.data.first <= 6;
      allow delete: if false;
    }
    // 닉네임 선점: 한 번 만들면 바꾸거나 지울 수 없어요
    match /organoid_rooms/{room}/names/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'at'])
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40;
      allow update, delete: if false;
    }
    // 금쪽같은 내 세포: 탄생 편 랭킹 (만점 160점)
    match /birth_rooms/{room}/scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'score', 'first', 'grade', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 160
        && request.resource.data.first is int
        && request.resource.data.first >= 0
        && request.resource.data.first <= 15;
      allow delete: if false;
    }
    match /birth_rooms/{room}/names/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'at'])
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40;
      allow update, delete: if false;
    }
    // 탄생 편 랭킹 회차: 누구나 읽고, 관리자 코드를 아는 사람만 올려요
    match /birth_meta/round {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['round', 'at'])
        && request.resource.data.round is int
        && getAfter(/databases/$(database)/documents/birth_admin_ops/last).data.round == request.resource.data.round
        && exists(/databases/$(database)/documents/birth_admin/$(getAfter(/databases/$(database)/documents/birth_admin_ops/last).data.code));
    }
    // 초기화 기록: 관리자 코드가 birth_admin에 있을 때만 쓸 수 있고, 아무도 읽을 수 없어요
    match /birth_admin_ops/last {
      allow read: if false;
      allow write: if request.resource.data.keys().hasOnly(['code', 'round', 'at'])
        && request.resource.data.code is string
        && request.resource.data.round is int
        && exists(/databases/$(database)/documents/birth_admin/$(request.resource.data.code));
    }
    // 관리자 코드: Firebase 콘솔에서만 만들 수 있고, 아무도 읽거나 쓸 수 없어요
    match /birth_admin/{code} {
      allow read, write: if false;
    }
  }
}
