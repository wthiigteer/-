rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 금쪽같은 내 오가노이드 랭킹: 누구나 읽기, 형식이 맞는 점수만 저장
    match /organoid_rooms/{room}/scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'score', 'first', 'grade', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 120
        && request.resource.data.score % 10 == 0
        && request.resource.data.first is int
        && request.resource.data.first >= 0
        && request.resource.data.first <= 6;
      allow delete: if false;
    }
    // 닉네임 선점: 한 번 만들면 바꾸거나 지울 수 없어요
    match /organoid_rooms/{room}/names/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'at'])
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40;
      allow update, delete: if false;
    }
    // 금쪽같은 내 오가노이드: 탄생 편 랭킹 (만점 160점)
    match /birth_rooms/{room}/scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'score', 'first', 'grade', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 160
        && request.resource.data.first is int
        && request.resource.data.first >= 0
        && request.resource.data.first <= 10;
      allow delete: if false;
    }
    match /birth_rooms/{room}/names/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'at'])
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40;
      allow update, delete: if false;
    }
  }
}
