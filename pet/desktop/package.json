{
  "name": "kkomi-tiger-pet",
  "productName": "Kkomi",
  "version": "1.0.0",
  "description": "원숭이 잠옷 입은 아기 호랑이 데스크톱 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . Kkomi --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist",
    "build:mac": "electron-packager . Kkomi --platform=darwin --arch=universal --out=dist --overwrite --ignore=^/dist"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "@electron/packager": "18.3.6"
  }
}
